class SearchBox {
  static #FILTER_CONTAINER = ".keys-for-index";
  static #INPUT_FIELD = "#query";
  static #KEYWORD = ".keyword";
  static #RESET_BUTTON = ".reset-filters";
  static #SEARCH_BUTTON = "#search-objects";
  static #SHOW_MORE_BUTTON = ".show-more-filters";
  static #TIME_FACET = ".time-facet-bubble";

  constructor(addClickHandler = true) {
    const self = this;

    self.searchButton = SearchBox.#SEARCH_BUTTON;
    if (addClickHandler) {
      jQuery(function () {
        self.#handleSearchButtonClick();
        self.#handleSearchInputFieldEvent();
      });
    }
  }

  /**
   * Add a keyword to the search box.
   */
  addKeyword(keyword) {
    this.getShowMoreButton().before(keyword);
    this.#handleResetButtonVisibility();
    renderShowMoreLessButton($(SearchBox.#FILTER_CONTAINER), true);
  }

  findKeywords(callback) {
    $(SearchBox.#FILTER_CONTAINER).find(SearchBox.#KEYWORD).each(function () {
      callback($(this));
    });
  }

  #getResetButton() {
    return $(SearchBox.#FILTER_CONTAINER).find(SearchBox.#RESET_BUTTON);
  }

  getSearchButton() {
    return $(this.searchButton);
  }

  static getSearchField() {
    return $(SearchBox.#INPUT_FIELD);
  }

  getSearchForm() {
    return this.getSearchButton().closest("form");
  }

  getShowMoreButton() {
    return $(SearchBox.#FILTER_CONTAINER).find(SearchBox.#SHOW_MORE_BUTTON);
  }

  handleResetButtonClick(callback) {
    const self = this;

    self.#getResetButton().click(function (e) {
      e.preventDefault();
      if (callback) {
        callback();
      } else {
        self.#removeAllKeywords();
      }
    });
  }

  #handleResetButtonVisibility() {
    const resetButton = this.#getResetButton();

    resetButton.stop(true, true);
    if ($(SearchBox.#FILTER_CONTAINER).find(SearchBox.#KEYWORD).length) {
      if (resetButton.hasClass("off")) {
        // 0 -> no animation
        resetButton.fadeIn(0, function () {
          $(this).removeClass("off");
        });
      }
    } else if (!resetButton.hasClass("off")) {
      // 0 -> no animation
      resetButton.fadeOut(0, function () {
        $(this).addClass("off");
      });
    }
  }

  #handleSearchButtonClick() {
    const self = this;

    self.getSearchButton().on("click", function (e) {
      e.preventDefault();

      const isSearchResultsPage = self.isSearchResultsPage();
      const inputField = SearchBox.getSearchField();
      const searchForm = self.getSearchForm();
      const searchParams = new URLSearchParams(window.location.search);
      const searchTerm = inputField.val();

      searchForm.find("input:hidden").each(function () {
        const name = $(this).attr("name");
        const value = $(this).val();

        searchParams.set(name, value);
      });

      GlobalScripts.showOverlay();
      StateManager.setParameters(self.searchParamsToArray(searchParams), false);
      StateManager.removeParameter(SearchParam.SORT, false);
      StateManager.removeParameter(SearchParam.OFFSET, false);
      if (searchTerm) {
        StateManager.setParameter(SearchParam.QUERY, searchTerm, isSearchResultsPage);
      } else {
        StateManager.removeParameter(SearchParam.QUERY, isSearchResultsPage);
      }
      if (!isSearchResultsPage) {
        window.location = $(this).data("path");
      }
    });
  }

  #handleSearchInputFieldEvent() {
    const self = this;

    SearchBox.getSearchField().on("keyup", function (e) {
      if (e.keyCode === 13) {
        self.search();
      }
    });
  }

  isSearchResultsPage() {
    return jsPageName === "objectsList" || jsPageName === "organizationsList" || jsPageName === "personsList";
  }

  /**
   * Check if keyword already exists.
   */
  keywordExists(keywordId) {
    let result = false;

    $(SearchBox.#FILTER_CONTAINER).find(SearchBox.#KEYWORD).each(function (index, keyword) {
      if ($(keyword).data("value").toString().equals(keywordId)) {
        result = true;
      }
    });
    return result;
  }

  #removeAllKeywords() {
    Keyword.removeKeywords($(SearchBox.#FILTER_CONTAINER).find(SearchBox.#KEYWORD));
    this.#handleResetButtonVisibility();
    renderShowMoreLessButton($(SearchBox.#FILTER_CONTAINER), true);
  }

  /**
   * Remove a keyword from the search box.
   */
  removeKeyword(keywordId) {
    Keyword.removeKeywords($(SearchBox.#FILTER_CONTAINER).find(".keyword[data-value='" + keywordId + "']"));
    this.#handleResetButtonVisibility();
    renderShowMoreLessButton($(SearchBox.#FILTER_CONTAINER), true);
  }

  removeTimeSpan() {
    $(SearchBox.#FILTER_CONTAINER).find(SearchBox.#TIME_FACET).remove();
    this.#handleResetButtonVisibility();
    renderShowMoreLessButton($(SearchBox.#FILTER_CONTAINER), true);
  }

  search() {
    this.getSearchButton().click();
  }

  /**
   * Convert a URLSearchParams object into an array suitable for StateManager.setParameters().
   */
  searchParamsToArray(searchParams) {
    const result = [];

    for (var value of searchParams.keys()) {
      result.push([value, searchParams.getAll(value)]);
    }
    return result;
  }
}

$(window).on('load', function () {
  $('#cookie-notice').each(function () {
    var cookieBar = $(this),
        acceptButton = cookieBar.find('#cookie-accept'),
        refuseButton = cookieBar.find('#cookie-refuse'),
        cookie = de.ddb.common.cookie.readCookie('cb_cookie_notice');

    de.ddb.common.cookie.tabbableElements = cookieBar.find($('a, button, input, textarea, select, details, [tabindex]:not([tabindex="-1"])'));

    de.ddb.common.cookie.trapFocusInsideCookieNotice = function (e) {
      // Tab key code
      if (e.keyCode === 9) {
        const firstTabbableEl = de.ddb.common.cookie.tabbableElements[0];
        const lastTabbableEl = de.ddb.common.cookie.tabbableElements[de.ddb.common.cookie.tabbableElements.length - 1];
        const isElChildOfCookieBar = cookieBar.find(e.target).length !== 0;

        if (!e.shiftKey) {
          if (
              !isElChildOfCookieBar ||
              e.target.isEqualNode(lastTabbableEl)
          ) {
            firstTabbableEl.focus();
            e.preventDefault();
          }
        } else if (
            !isElChildOfCookieBar ||
            e.target.isEqualNode(firstTabbableEl)
        ) {
          lastTabbableEl.focus();
          e.preventDefault();
        }
      }
    };

    window.setTimeout(function () {
      //If cookie no set
      if (cookie !== 'MQ==' && cookie !== 'MA==') {
        // 1 and 0 in Base64
        cookieBar.fadeIn('fast');

        document.addEventListener('keydown', de.ddb.common.cookie.trapFocusInsideCookieNotice);
      }
    }, 300);

    de.ddb.common.cookie.cookieButton = function(button, value) {
      button.on('click', function (evt) {
        evt.preventDefault();
        cookieBar.removeClass('visible');
        cookieBar.fadeOut('fast');

        document.removeEventListener('keydown', de.ddb.common.cookie.trapFocusInsideCookieNotice);

        de.ddb.common.cookie.setCookie('cb_cookie_notice', value);

        return false;
      });
    };

    de.ddb.common.cookie.cookieButton(acceptButton, '1');
    de.ddb.common.cookie.cookieButton(refuseButton, '0');
  });

  // append value to attribute "rel" in anchor tags with target="_blank"
  $("a[target='_blank']").attr("rel",  function( i, val ) {
    return `${val ?? ''} nofollow noopener noreferrer`;
  });
});

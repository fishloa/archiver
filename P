class KeyupHandler {
  #KEY_CODE = {
    ALT: 18,
    CONTROL: 17,
    DOWN: 40,
    ENTER: 13,
    LEFT: 37,
    RIGHT: 39,
    SHIFT: 16,
    TAB: 9,
    UP: 38
  };

  constructor(inputField, minLength = 2) {
    this.inputField = inputField;
    this.minLength = minLength;
  }

  init(callback) {
    const self = this;
    const IGNORED_KEYCODES = new Set([
      self.#KEY_CODE.SHIFT, self.#KEY_CODE.CONTROL, self.#KEY_CODE.ALT, self.#KEY_CODE.LEFT, self.#KEY_CODE.UP,
      self.#KEY_CODE.RIGHT, self.#KEY_CODE.DOWN, self.#KEY_CODE.ENTER, self.#KEY_CODE.TAB]);
    let timer = 0;

    self.inputField.keyup(function (e) {
      const code = (e.keyCode ? e.keyCode : e.which);

      if (!IGNORED_KEYCODES.has(code)) {
        clearInterval(timer);

        const inputValue = this.value;

        if (inputValue.length === 0 || inputValue.length >= self.minLength) {
          timer = setTimeout(function () {
            callback(inputValue);
          }, 500);
        }
      }
    });
  }
}

  static #CATEGORY_CHECKBOX = ".select_all_themen input";
  static #CONTAINER = ".explore-topics-content";
  static #SUB_CATEGORY_CHECKBOX = ".select-category_themen input";
  static #TOPIC = ".image__cell";
  static #TOPIC_CONTENT = ".image--expand";

  constructor() {
    var self = this;

    jQuery(function ($) {
      self.#handleCloseButtonClick();
      self.#handleKeyEvent();
      self.#handleMenuItemCategories();
      self.#handleTopicClick();
      self.#handleTopicSelectAll();
      self.imageCellHoverState();
      Keyword.handleKeywordTooltips();
      GlobalScripts.handleWindowResize(function () {
        const visibleTile = $(Topics.#TOPIC_CONTENT + ":visible").parent();

        if (visibleTile.length) {
          self.#setTilePosition(visibleTile);
          self.#setTileWidth(visibleTile);
        }
      });
    });
  }

  getSubCategorySelectAllCheckbox(categoryId) {
    return $(Topics.#SUB_CATEGORY_CHECKBOX + "[value=" + categoryId + "]");
  }

  #handleCloseButtonClick() {
    var cell = $(Topics.#TOPIC);

    cell.find('.expand__close').click(function () {
      var thisCell = $(this).closest(Topics.#TOPIC);

      thisCell.removeClass('is-expanded').addClass('is-collapsed');
    });
  }

  #handleKeyEvent() {
    var cell = $(Topics.#TOPIC);

    cell.find(Topics.#TOPIC_CONTENT).keyup(function (e) {
      if (e.key === "Escape") {
        var thisCell = $(Topics.#TOPIC + ".is-expanded");

        if (thisCell) {
          thisCell.find(".image--basic").trigger("click").focus();
        }
      }
    });
  }

  /**
   * Click event to trigger the open & close of menu_item_categories.
   */
  #handleMenuItemCategories() {
    var self = this;

    $(Topics.#CATEGORY).click(function () {
      var category = $(this);
      var categoryId = category.data("id").toString();
      var menuItemKeywords = $(".menu_item_keywords[data-id=" + categoryId + "]");
      var menuKeywords = $('.is-expanded .menu_item_keywords');

      menuKeywords.addClass("hidden").removeClass("visible-flex");

      // Case already opened menu -> close menu
      if (category.hasClass("selected")) {
        category.removeClass("selected");
        self.getSubCategorySelectAllCheckbox(categoryId).parent().addClass("hidden");
        menuItemKeywords.addClass("hidden").removeClass("visible-flex");
      }
      // Case closed menu -> open menu and close others
      else {
        $(Topics.#CATEGORY).removeClass("selected");
        var menuItemCheckBox = self.getSubCategorySelectAllCheckbox(categoryId);

        category.addClass("selected");
        menuItemCheckBox.parent().removeClass("hidden");
        menuItemKeywords.addClass("visible-flex").removeClass("hidden");
        menuItemCheckBox.focus();
      }
    });
  }

  handleSubCategorySelectAll(callback) {
    if (callback) {
      $(Topics.#SUB_CATEGORY_CHECKBOX).change(function () {
        callback($(this));
      });
    }
  }

  #handleTopicClick() {
    var self = this;
    var cell = $(Topics.#TOPIC);

    cell.find('.image--basic').unbind().on("click", function () {
      $(Topics.#SUB_CATEGORY_CHECKBOX).parent().addClass("hidden");

      var thisCell = $(this).closest(Topics.#TOPIC);

      if (thisCell.hasClass('is-collapsed')) {
        if (!BreakPoints.isExtraSmallMobile()) {
          self.#showAllKeywordsForCell(thisCell);
        }
        cell.not(thisCell).removeClass('is-expanded').addClass('is-collapsed');
        thisCell.removeClass('is-collapsed').addClass('is-expanded');

        self.#setTilePosition(thisCell);
        self.#setTileWidth(thisCell);
      } else {
        thisCell.removeClass('is-expanded').addClass('is-collapsed');
      }
    });
  }

  #handleTopicSelectAll() {
    $(Topics.#CATEGORY_CHECKBOX).click(function () {
      var tileCategoryId = $(this).attr("id").split("_")[2];
      var isChecked = $(this).prop("checked");

      $(".menu_item_categories_wrapper[data-id=" + tileCategoryId + "]").find(Topics.#SUB_CATEGORY_CHECKBOX).prop("checked", !isChecked).click();
    });
  }

  imageCellHoverState() {
    $(Topics.#TOPIC).each(function () {
      $(this).removeClass('contain__keywords');
      $(this).removeClass('no__keywords');

      var count = 0;

      $(".keyword-count").each(function () {
        count += parseFloat($(this).text());
      });
      if (count === 0) {
        $(this).addClass('no__keywords');
      } else {
        $(this).addClass('contain__keywords');
      }
    });
  }

  #setTilePosition(tile) {
    if (tile) {
      const container = tile.closest(Topics.#CONTAINER);

      if (container.length) {
        tile.find(Topics.#TOPIC_CONTENT).css("left", container.offset().left - tile.offset().left);
      }
    }
  }

  #setTileWidth(tile) {
    if (tile) {
      const container = tile.closest(Topics.#CONTAINER);

      if (container.length) {
        tile.find(Topics.#TOPIC_CONTENT).css("width", container.width());
      }
    }
  }

  #showAllKeywordsForCell(cell) {
    // unselect all categories
    $(Topics.#CATEGORY).removeClass("selected");

    // show all keywords
    var keywords = cell.find(".menu_item_keywords");

    keywords.addClass("visible-flex").removeClass("hidden");
  }
}

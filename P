class Keyword {
// https://stackoverflow.com/questions/35939886/find-first-scrollable-parent
  static #getScrollParent(element, includeHidden) {
    let style = getComputedStyle(element);
    const excludeStaticParent = style.position === "absolute";
    const overflowRegex = includeHidden ? /(auto|scroll|hidden)/ : /(auto|scroll)/;

    if (style.position === "fixed") {
      return document.body;
    }

    let parent = element;

    while ((parent = parent.parentElement)) {
      style = getComputedStyle(parent);
      if (excludeStaticParent && style.position === "static") {
        continue;
      }
      if (overflowRegex.test(style.overflow + style.overflowY + style.overflowX)) {
        return parent;
      }
    }
    return document.body;
  }

  static handleHover() {
    const iconBox = ".keyword.hoverable .icon-box";

    $(document).on("click", iconBox, function (e) {
      e.preventDefault();
      // remove "hovered" on click for mobile devices
      $(this).removeClass("hovered");
    }).on("mouseenter", iconBox, function () {
      $(this).addClass("hovered");
    }).on("mouseleave", iconBox, function () {
      $(this).removeClass("hovered");
    });

    const keywordBox = ".keyword.hoverable .keyword-box";

    $(document).on("click", keywordBox, function () {
      // remove "hovered" on click for mobile devices
      $(this).parent().removeClass("hovered");
    }).on("mouseenter", keywordBox, function () {
      $(this).parent().addClass("hovered");
    }).on("mouseleave", keywordBox, function () {
      $(this).parent().removeClass("hovered");
    });
  }

  static handleKeywordClick(callback) {
    if (callback) {
      $(".keyword-box").click(function (e) {
        Keyword.#hideTooltips(e);
        callback($(this));
      });
    }
  }

  static handleKeywordTooltips() {
    $('.keyword [data-bs-toggle="tooltip"]').off('hidden.bs.tooltip').on('hidden.bs.tooltip', function () {
      $(this).removeClass("visible");
    }).off('show.bs.tooltip').on('show.bs.tooltip', function () {
      $(".tooltip").tooltip("hide");
    }).off('shown.bs.tooltip').on('shown.bs.tooltip', function () {
      const tooltip = $(this);

      tooltip.addClass("visible");
      $(Keyword.#getScrollParent(tooltip.get(0))).on('scroll', function () {
        tooltip.tooltip("hide");
      });
    }).each(function () {
      let keyword = $(this);

      keyword.tooltip({
        container: keyword,
        fallbackPlacements: [],
        html: true,
        offset: ({popper}) => {
          return [popper.x + popper.width / 2 - 17, popper.y];
        },
        placement: "top",
        template: '' +
          '<div class="keyword-tooltip tooltip" role="tooltip">' +
          '  <div class="tooltip-inner"></div>' +
          '  <div class="triangle-down"></div>' +
          '</div>',
        trigger: "click"
      });
    });

    $(document).on("click", function (e) {
      Keyword.#hideTooltips(e);
    });
  }

  // hide tooltips on outside click
  static #hideTooltips(e) {
    $('.keyword .visible[data-bs-toggle="tooltip"]').each(function () {
      if ($(this).has(e.target).length === 0) {
        $(this).tooltip("hide");
      }
    });
  }

  static removeKeywords(keywords) {
    $(".tooltip").tooltip("hide");
    keywords.remove();
  }

  // render filter bubble
  static renderFilter(name, value, label, closeAction) {
    const result = $(".prototypes .keyword[data-type='none']").first().clone();

    result.addClass("filter");
    result.attr("data-filter-type", name);
    result.attr("data-filter-value", value);
    result.find(".keyword-label").text(label);
    result.find(".close-box").click(function (e) {
      closeAction(e);
    });
    return result;
  }
}


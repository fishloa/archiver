function handleLogoutButton() {
  $(document).click(function () {
    $(".logout-button.show").removeClass("show");
  });
}

function handleNavbar() {
  $('.navbar-collapse-apd').on('shown.bs.collapse', function () {
    if (isBurgerMenuOpen()) {
      $('body').addClass('lock-scroll');
    }
  });

  $('.navbar-collapse-apd').on('hidden.bs.collapse', function () {
    $('body').removeClass('lock-scroll');
  });
}

function handleRtlSwitch() {
  $("#rtl-switch").change(function () {
    if ($(this).is(":checked")) {
      $("html").attr("dir", "rtl");
    } else {
      $("html").removeAttr("dir");
    }
  });
}

function isBurgerMenuOpen() {
  const navbar = $("#navbarResponsive");

  return navbar.is(":visible") && navbar.css("flex-basis") === "100%";
}

function isMobileMenu() {
  const currentBreakPoint = BreakPoints.getCurrentBreakPoint();

  return currentBreakPoint === BreakPoints.VIEWPORT_MD || currentBreakPoint === BreakPoints.VIEWPORT_SM || currentBreakPoint === BreakPoints.VIEWPORT_XS;
}

function modifyMenu() {
  var navItems = $(".apd-header .navbar-nav-apd .nav-item-apd");
  var navLinks = navItems.find(".nav-link-apd[data-bs-toggle=dropdown]");
  var dropdownMenus = navItems.find(".dropdown-menu");

  if (isMobileMenu()) {
    navLinks.dropdown("hide");
    navLinks.removeClass("dropdown-toggle");
    dropdownMenus.addClass("show");
  } else {
    navLinks.addClass("dropdown-toggle");
    dropdownMenus.removeClass("show");
  }
}

jQuery(function () {
  var lastMobileMenu = isMobileMenu();

  handleGotoMainContent();
  handleLoginButton();
  handleLogoutButton();
  handleNavbar();
  handleRtlSwitch();
  modifyMenu();
  BreakPoints.handleBreakPointChange(function () {
    var mobileMenu = isMobileMenu();

    if (lastMobileMenu !== mobileMenu) {
      modifyMenu();
      lastMobileMenu = mobileMenu;
    }
  });
});

function prepareDropdownMenus() {
  if (BreakPoints.isDesktop()) {
    $(".viewport-mobile").remove();
  } else {
    $(".viewport-desktop").hide();
    //Convert dropdown menus into collapsible menus
    $.each($(".dropend"), function () {
      replaceClass($(this), "dropend", "nodropend");

      const menu = $(this).parent().find(".dropdown-menu");

      if (menu.length > 0) {
        menu.addClass("collapse");
        replaceClass(menu, "dropdown-menu", "collapse-menu");

        const link = $(this).find('[data-bs-toggle="dropdown"]');

        link.addClass("collapsed");
        replaceAttr(link, "data-bs-toggle", "collapse");
        replaceAttr(link, "data-bs-target", "#" + $(this).parent().find(".collapse").attr("id"));
      }
    });
  }
}

function replaceAttr(item, attrName, attrValue) {
  if (item.attr(attrName) == null || !item.attr(attrName).equals(attrValue)) {
    item.attr(attrName, attrValue);
  }
}

function replaceClass(item, oldClass, newClass) {
  if (item.hasClass(oldClass) && !item.hasClass(newClass)) {
    item.removeClass(oldClass).addClass(newClass);
  }
}


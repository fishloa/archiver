class BreakPoints {
  static VIEWPORT_XXL = "xxl";
  static VIEWPORT_XL = "xl";
  static VIEWPORT_LG = "lg";
  static VIEWPORT_MD = "md";
  static VIEWPORT_SM = "sm";
  static VIEWPORT_XS = "xs";
  static #NAMES = [BreakPoints.VIEWPORT_XXL, BreakPoints.VIEWPORT_XL, BreakPoints.VIEWPORT_LG, BreakPoints.VIEWPORT_MD, BreakPoints.VIEWPORT_SM, BreakPoints.VIEWPORT_XS];
  static #PREFIX = "--bs-breakpoint-";
  static #VALUES = [];

  static {
    $.each(BreakPoints.#NAMES, function (index, name) {
      const value = window.getComputedStyle(document.documentElement).getPropertyValue(BreakPoints.#PREFIX + name);

      if (value) {
        BreakPoints.#VALUES[name] = value;
      }
    });
  }

  static getCurrentBreakPoint() {
    let result;

    $.each(BreakPoints.#NAMES, function (index, name) {
      if (window.matchMedia("(min-width: " + BreakPoints.#VALUES[name] + ")").matches) {
        result = name;
        return false;
      }
    });
    return result;
  }

  static handleBreakPointChange(callback) {
    let lastBreakpoint = BreakPoints.getCurrentBreakPoint();

    GlobalScripts.handleWindowResize(function () {
      const breakpoint = BreakPoints.getCurrentBreakPoint();

      if (breakpoint !== lastBreakpoint) {
        if (callback) {
          callback();
        } else {
          location.reload();
        }
        lastBreakpoint = breakpoint;
      }
    });
  }

  static isDesktop() {
    const currentBreakPoint = BreakPoints.getCurrentBreakPoint();

    return currentBreakPoint === BreakPoints.VIEWPORT_XXL || currentBreakPoint === BreakPoints.VIEWPORT_XL || currentBreakPoint === BreakPoints.VIEWPORT_LG;
  };

  static isExtraSmallMobile() {
    return BreakPoints.getCurrentBreakPoint() === BreakPoints.VIEWPORT_XS;
  };

  static isMobile() {
    const currentBreakPoint = BreakPoints.getCurrentBreakPoint();

    return currentBreakPoint === BreakPoints.VIEWPORT_SM || currentBreakPoint === BreakPoints.VIEWPORT_XS;
  };
}

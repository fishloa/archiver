class Dropdown {
  static #CLASS_CROSS_HAIR = "cross-hair";
  static #CLASS_DISABLED = "disabled";
  static #CLASS_MULTISELECT = "multi-select";
  static #CLASS_SELECTED = "selected";
  static #CLASS_VALUE = "value";

  static #DATA_TITLE = "title";
  static #DATA_VALUE = "value";

  static #SELECTOR_ARROW = ".arrow";
  static #SELECTOR_BUTTON = ".btn-dropdown";
  static SELECTOR_CONTAINER = ".apd-dropdown";
  static #SELECTOR_DEFAULT_TEXT = ".default-text";
  static #SELECTOR_HIDDEN_FIELD = "input[type=hidden]";
  static #SELECTOR_LABEL = ".label";
  static #SELECTOR_LIST = "li:not(.disabled)";
  static #SELECTOR_CROSS_HAIR = Dropdown.#SELECTOR_LIST + " ." + Dropdown.#CLASS_CROSS_HAIR;
  static #SELECTOR_VALUE = Dropdown.#SELECTOR_LIST + " ." + Dropdown.#CLASS_VALUE;

  static clearSelection(container) {
    container.find(Dropdown.#SELECTOR_LIST).each(function () {
      $(this).removeClass(Dropdown.#CLASS_SELECTED);
    });

    // restore default text
    const button = Dropdown.#getSelectorButton(container);
    const defaultText = button.data(Dropdown.#DATA_TITLE);

    if (defaultText) {
      Dropdown.#setDefaultText(container, defaultText);
    }
  }

  static #getContainer(item) {
    return item.parents(Dropdown.SELECTOR_CONTAINER);
  }

  static getFormFieldName(container) {
    return container.find(Dropdown.#SELECTOR_HIDDEN_FIELD).attr("name");
  }

  static getItem(container, value) {
    return container.find(Dropdown.#SELECTOR_VALUE + "[data-value='" + value + "']");
  }

  static getLabel(container, value) {
    return Dropdown.getItem(container, value).find(Dropdown.#SELECTOR_LABEL).text();
  }

  static getSelectedLabel(container) {
    return container.find(Dropdown.#SELECTOR_DEFAULT_TEXT).text().trim();
  }

  static getSelectedValue(container) {
    const result = Dropdown.getSelectedValues(container);

    return result.length > 0 ? result[0] : "";
  }

  static getSelectedValues(container) {
    const result = [];

    container.find(Dropdown.#SELECTOR_LIST).each(function () {
      if (Dropdown.#isSelected($(this))) {
        result.push($(this).find("." + Dropdown.#CLASS_VALUE).data(Dropdown.#DATA_VALUE));
      }
    });
    return result;
  }

  static #getSelectorButton(container) {
    return container.find(Dropdown.#SELECTOR_BUTTON);
  }

  static getValues(container) {
    const result = [];

    container.find(Dropdown.#SELECTOR_LIST).each(function () {
      result.push($(this).find("." + Dropdown.#CLASS_VALUE).data(Dropdown.#DATA_VALUE));
    });
    return result;
  }

  static init(container) {
    // remove multi select value
    container.on("click", Dropdown.#SELECTOR_CROSS_HAIR, function () {
      const item = $(this).parent();
      const container = Dropdown.#getContainer(item);

      Dropdown.removeSelectedItem(item);

      const selectedValues = Dropdown.getSelectedValues(container);

      if (selectedValues.length > 0) {
        Dropdown.#setSelectedItem(Dropdown.getItem(container, selectedValues[0]));
      }
    });

    // change dropdown value
    container.on("click", Dropdown.#SELECTOR_VALUE, function (e) {
      if (!$(e.target).hasClass(Dropdown.#CLASS_CROSS_HAIR)) {
        Dropdown.#setSelectedItem($(this));
      }
    });

    container.on("disable", function (event) {
      Dropdown.getItem($(this), event.value).parent().addClass(Dropdown.#CLASS_DISABLED);
    });

    container.on("removeEntry", function (event) {
      Dropdown.getItem($(this), event.value).parent().remove();
      if (event.value.equals(Dropdown.getSelectedValue($(this))) && !Dropdown.#isMultiSelect(container)) {
        Dropdown.#setDefaultText(container, "");
        container.find(Dropdown.#SELECTOR_HIDDEN_FIELD).val("");
      }
    });

    container.on("updateEntry", function (event) {
      const item = Dropdown.getItem($(this), event.value);
      const container = Dropdown.#getContainer(item);

      item.text(event.label);
      if (event.value.equals(Dropdown.getSelectedValue($(this))) && !Dropdown.#isMultiSelect(container)) {
        Dropdown.#setDefaultText(container, event.label);
      }
    });

    container.each(function () {
      Dropdown.#setDefaultTextWidth($(this));
    });

    const selectorButton = Dropdown.#getSelectorButton(container);

    selectorButton.on("hidden.bs.dropdown", function () {
      $(this).focus();
    }).on("shown.bs.dropdown", function () {
      const firstItem = Dropdown.#getContainer($(this)).find(Dropdown.#SELECTOR_LIST).first();

      // focus() triggers key event, ignore this.
      firstItem.data("focus", true);
      firstItem.focus();
    });

    const selectorList = container.find(Dropdown.#SELECTOR_LIST);

    selectorList.on("mouseenter", function () {
      if (!GlobalScripts.isTouchDevice()) {
        $(this).tooltip("show");
      }
    }).on("mouseleave", function () {
      $(this).tooltip("hide");
    }).on("keyup", function (e) {
      if ($(this).data("focus")) {
        $(this).data("focus", false);
      } else {
        if (e.which === 13) {
          if (Dropdown.#isMultiSelect(Dropdown.#getContainer($(this))) && Dropdown.#isSelected($(this))) {
            $(this).find("." + Dropdown.#CLASS_CROSS_HAIR).trigger("click");
          } else {
            $(this).find("." + Dropdown.#CLASS_VALUE).trigger("click");
          }
          Dropdown.#getSelectorButton(Dropdown.#getContainer($(this))).focus();
        } else if (e.which === 35) {
          Dropdown.#getContainer($(this)).find(Dropdown.#SELECTOR_LIST).last().focus();
        } else if (e.which === 36) {
          Dropdown.#getContainer($(this)).find(Dropdown.#SELECTOR_LIST).first().focus();
        } else if (e.which === 38) {
          $(this).prevAll(":not(." + Dropdown.#CLASS_DISABLED + ")").first().focus();
        } else if (e.which === 40) {
          $(this).nextAll(":not(." + Dropdown.#CLASS_DISABLED + ")").first().focus();
        }
      }
    });
  }

  static #isMultiSelect(container) {
    return container.hasClass(Dropdown.#CLASS_MULTISELECT);
  }

  static #isSelected(item) {
    return item.hasClass(Dropdown.#CLASS_SELECTED);
  }

  static removeSelectedItem(item, sendEvent = true) {
    if (item) {
      const container = Dropdown.#getContainer(item);
      const value = item.data(Dropdown.#DATA_VALUE);

      item.parent().removeClass(Dropdown.#CLASS_SELECTED);
      if (sendEvent) {
        container.trigger({type: "change", value: value, values: Dropdown.getSelectedValues(container)});
      }
    }
  }

  static #setDefaultText(container, text) {
    container.find(Dropdown.#SELECTOR_DEFAULT_TEXT).text(text);
  }

  static #setDefaultTextWidth(container) {
    const button = Dropdown.#getSelectorButton(container);
    const arrow = button.find(Dropdown.#SELECTOR_ARROW);
    const buttonWidth = button.scrollWidth;

    if (buttonWidth > 0 && !Dropdown.#isMultiSelect(container)) {
      // assume left and right margin have same size
      const leftMargin = (buttonWidth - button.innerWidth()) / 2;

      container.find(Dropdown.#SELECTOR_DEFAULT_TEXT).width(buttonWidth - arrow.width() - leftMargin);
    }
  }

  static #setSelectedItem(item, sendEvent = true) {
    if (item) {
      const container = Dropdown.#getContainer(item);
      const value = item.data(Dropdown.#DATA_VALUE);

      // deselect all items
      if (!Dropdown.#isMultiSelect(container)) {
        container.find(Dropdown.#SELECTOR_LIST).removeClass(Dropdown.#CLASS_SELECTED);
      }

      // set selected item
      if (!Dropdown.#isMultiSelect(container)) {
        Dropdown.#setDefaultText(container, item.text());
        container.find(Dropdown.#SELECTOR_HIDDEN_FIELD).val(value);
      }

      // select the given item
      if (!(Dropdown.#isMultiSelect(container) && Dropdown.#isSelected(item.parent()))) {
        item.parent().addClass(Dropdown.#CLASS_SELECTED);
        if (sendEvent) {
          container.trigger({type: "change", value: value, values: Dropdown.getSelectedValues(container)});
        }
      }
    }
  }

  static setSelectedValue(container, value, sendEvent = true) {
    Dropdown.#setSelectedItem(Dropdown.getItem(container, value), sendEvent);
  }
}


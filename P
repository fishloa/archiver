class Combobox {
  static #ATTRIBUTE_DISABLED = "disabled";
  static #ATTRIBUTE_VALUE = "data-value";

  static #CLASS_OFF = "off";
  static #CLASS_SELECTED = "selected";

  static #DATA_FACET = "facet";
  static #DATA_INDEX = "index";

  static #RESULTS_PER_PAGE = 10;

  static #SELECTOR_BUTTON = ".btn-combobox";
  static SELECTOR_CONTAINER = ".apd-combobox";
  static #SELECTOR_ICON = ".icon-combobox";
  static #SELECTOR_LABEL = ".label";
  static #SELECTOR_LIST = "ul";
  static #SELECTOR_LIST_ITEM = "li";
  static #SELECTOR_MENU = ".dropdown-menu";
  static #SELECTOR_NEXT_BUTTON = ".next";
  static #SELECTOR_PAGE_NUMBER = ".page-number";
  static #SELECTOR_PREV_BUTTON = ".prev";
  static #SELECTOR_PAGE_NAV = ".page-nav";
  static #SELECTOR_SPINNER = ".apd-spinner";
  static #SELECTOR_TOOLTIP = ".tooltip";

  constructor(container) {
    this.container = container;

    const menu = container.find(Combobox.#SELECTOR_MENU);
    const list = menu.find(Combobox.#SELECTOR_LIST);

    this.item = list.find(Combobox.#SELECTOR_LIST_ITEM);
  }

  static clearSelection(container) {
    container.find(Combobox.#SELECTOR_LIST).each(function () {
      $(this).removeClass(Combobox.#CLASS_SELECTED);
    });

    const button = container.find(Combobox.#SELECTOR_BUTTON);

    button.val("");
  }

  #fetchResults(parameters, callback) {
    // sort facets alphabetically
    parameters.set(SearchParam.SORT, "true");

    this.parameters = parameters.toString();

    let path = "/facets";
    const index = parameters.get(SearchParam.INDEX);

    if (index === "wgm") {
      path = "/personen/wgm/facets";
    }
    $.get(jsContextPath + path + "?" + this.parameters, function (data) {
      callback(data);
    });
  }

  static getFormFieldName(container) {
    const icon = container.find(Combobox.#SELECTOR_ICON);

    return icon.data(Combobox.#DATA_FACET);
  }

  #getParameters(facet, index, query) {
    const result = new URLSearchParams();

    result.set(SearchParam.INDEX, index);
    result.set(SearchParam.NAME, facet);
    result.set(SearchParam.QUERY, query);

    // add filterValues from current URL
    const windowParams = de.ddb.common.search.getUrlVars();

    $.each(windowParams[SearchParam.FILTER_VALUES], function (key, value) {
      result.append(SearchParam.FILTER_VALUES, value);
    });

    return result;
  }

  static getSelectedValue(container) {
    let result = container.find(Combobox.#SELECTOR_BUTTON).val();

    return result ? result.trim() : null;
  }

  #getSelectedValue() {
    return Combobox.getSelectedValue(this.container);
  }

  init() {
    const self = this;
    const button = self.container.find(Combobox.#SELECTOR_BUTTON);
    const icon = self.container.find(Combobox.#SELECTOR_ICON);
    const facet = icon.data(Combobox.#DATA_FACET);
    const index = icon.data(Combobox.#DATA_INDEX);
    const menu = self.container.find(Combobox.#SELECTOR_MENU);

    button.on("change", function (e) {
      // prevent triggering change event
      e.preventDefault();
      return false;
    }).on("focus", function () {
      $(this).val("");
    });

    const keyupHandler = new KeyupHandler(button);

    keyupHandler.init(function (inputValue) {
      menu.addClass("show");
      self.#fetchResults(self.#getParameters(facet, index, inputValue), function (data) {
        self.data = data;
        self.partialData = true;
        self.#showResults(self.data, 0);
      });
    });

    self.container.on("click", Combobox.#SELECTOR_LIST_ITEM, function () {
      self.#setSelectedItem($(this));
    }).on("keyup", Combobox.#SELECTOR_LIST_ITEM, function (e) {
      if ($(this).data("focus")) {
        $(this).data("focus", false);
      } else {
        if (e.which === 13) {
          self.#setSelectedItem($(this));
        } else if (e.which === 35) {
          container.find(Combobox.#SELECTOR_LIST).last().focus();
        } else if (e.which === 36) {
          container.find(Combobox.#SELECTOR_LIST).first().focus();
        } else if (e.which === 38) {
          $(this).prevAll().first().focus();
        } else if (e.which === 40) {
          $(this).nextAll().first().focus();
        }
      }
    }).on("mouseenter", Combobox.#SELECTOR_LIST_ITEM, function () {
      if (!GlobalScripts.isTouchDevice()) {
        $(this).tooltip("show");
      }
    }).on("mouseleave", Combobox.#SELECTOR_LIST_ITEM, function () {
      $(this).tooltip("hide");
    });

    icon.on("hide.bs.dropdown", function () {
      if (self.partialData) {
        self.data = null;
        self.partialData = false;
      }
    }).on("shown.bs.dropdown", function (e) {
      self.#setDropdownOffset(e.relatedTarget);
      self.#showPage();
    });
  }

  #setDropdownOffset(targetElement) {
    const dropdown = bootstrap.Dropdown.getInstance(targetElement);
    const target = $(targetElement);
    const left = target.parent().offset().left - target.offset().left;

    dropdown._popper.setOptions({modifiers: [{name: "offset", options: {offset: [left, 0]}}]});
  }

  #setSelectedItem(item, sendEvent = true) {
    if (item) {
      const button = this.container.find(Combobox.#SELECTOR_BUTTON);
      const icon = this.container.find(Combobox.#SELECTOR_ICON);
      const value = item.attr(Combobox.#ATTRIBUTE_VALUE);

      button.val(value);
      icon.trigger("click");
      if (sendEvent) {
        this.container.trigger({type: "change", value: value});
      }
    }
  }

  static setSelectedValue(container, value, sendEvent = true) {
    const button = container.find(Combobox.#SELECTOR_BUTTON);

    button.val(value);
    if (sendEvent) {
      container.trigger({type: "change", value: value});
    }
  }

  #showPage(offset = 0) {
    const self = this;
    const icon = self.container.find(Combobox.#SELECTOR_ICON);
    const facet = icon.data(Combobox.#DATA_FACET);
    const index = icon.data(Combobox.#DATA_INDEX);
    const menu = self.container.find(Combobox.#SELECTOR_MENU);
    const list = menu.find(Combobox.#SELECTOR_LIST);
    const pageNav = menu.find(Combobox.#SELECTOR_PAGE_NAV);
    const nextButton = pageNav.find(Combobox.#SELECTOR_NEXT_BUTTON);
    const prevButton = pageNav.find(Combobox.#SELECTOR_PREV_BUTTON);
    const spinner = menu.find(Combobox.#SELECTOR_SPINNER);

    $(Combobox.#SELECTOR_TOOLTIP).hide();
    spinner.removeClass(Combobox.#CLASS_OFF);
    list.find(Combobox.#SELECTOR_LIST_ITEM).remove();
    pageNav.addClass(Combobox.#CLASS_OFF);
    prevButton.attr(Combobox.#ATTRIBUTE_DISABLED, true);
    nextButton.attr(Combobox.#ATTRIBUTE_DISABLED, true);

    const parameters = self.#getParameters(facet, index, "");

    if (self.data && parameters.toString().equals(self.parameters)) {
      self.#showResults(self.data, offset);
    } else {
      self.#fetchResults(parameters, function (data) {
        self.data = data;
        self.#showResults(self.data, offset);
      });
    }
  }

  #showResults(data, offset) {
    const self = this;
    const menu = self.container.find(Combobox.#SELECTOR_MENU);
    const list = menu.find(Combobox.#SELECTOR_LIST);
    const pageNav = menu.find(Combobox.#SELECTOR_PAGE_NAV);
    const prevButton = pageNav.find(Combobox.#SELECTOR_PREV_BUTTON);
    const pageNumber = pageNav.find(Combobox.#SELECTOR_PAGE_NUMBER);
    const nextButton = pageNav.find(Combobox.#SELECTOR_NEXT_BUTTON);
    const spinner = menu.find(Combobox.#SELECTOR_SPINNER);
    const selectedValue = self.#getSelectedValue();

    list.find(Combobox.#SELECTOR_LIST_ITEM).remove();
    $.each(data.values, function (index, value) {
      if (index >= offset + Combobox.#RESULTS_PER_PAGE) {
        return false;
      }
      if (index >= offset) {
        const newItem = self.item.clone();

        if (!GlobalScripts.isTouchDevice()) {
          bootstrap.Tooltip.getOrCreateInstance(newItem.get(0), {
            template: '' +
              '<div class="tooltip" role="tooltip">' +
              '  <div class="tooltip-inner"></div>' +
              '</div>',
            title: value.localizedValue.replace('<strong>', '').replace('</strong>', '')
          });
        }
        newItem.attr(Combobox.#ATTRIBUTE_VALUE, value.value);
        newItem.find(Combobox.#SELECTOR_LABEL).html(value.localizedValue);
        if (value.value.equals(selectedValue)) {
          newItem.addClass(Combobox.#CLASS_SELECTED);
        }
        list.append(newItem);
        nextButton.attr(Combobox.#ATTRIBUTE_DISABLED, offset + Combobox.#RESULTS_PER_PAGE >= data.values.length);
      }
    });
    spinner.addClass(Combobox.#CLASS_OFF);
    if (offset > 0) {
      prevButton.attr(Combobox.#ATTRIBUTE_DISABLED, false);
    }
    pageNumber.text(offset / Combobox.#RESULTS_PER_PAGE + 1);
    pageNav.removeClass(Combobox.#CLASS_OFF);

    nextButton.off("click").on("click", function (e) {
      e.preventDefault();

      const pageNav = $(this).closest(Combobox.#SELECTOR_PAGE_NAV);
      const pageNumber = parseInt(pageNav.find(Combobox.#SELECTOR_PAGE_NUMBER).text());

      self.#showPage(pageNumber * Combobox.#RESULTS_PER_PAGE);
    });

    prevButton.off("click").on("click", function (e) {
      e.preventDefault();

      const pageNav = $(this).closest(Combobox.#SELECTOR_PAGE_NAV);
      const pageNumber = parseInt(pageNav.find(Combobox.#SELECTOR_PAGE_NUMBER).text());

      self.#showPage((pageNumber - 2) * Combobox.#RESULTS_PER_PAGE);
    });
  }
}


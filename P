class Checkbox {
  /**
   * @param checkbox input field with type=checkbox
   */
  constructor(checkbox) {
    this.checkbox = checkbox;
  }

  setChecked(checked) {
    this.checkbox.prop("checked", checked);
  }

  setDisabled(disabled) {
    this.checkbox.prop("disabled", disabled);
    if (disabled) {
      this.checkbox.parent().addClass("disabled");
    } else {
      this.checkbox.parent().removeClass("disabled");
    }
  }
}

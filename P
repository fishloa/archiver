/**
 * State Manager
 *
 * The main intend of this object is to handle the state of the structure and object page.
 * The state is defined by the selected filter and facet values as well as pagination parameters like rows, offset and sort.
 *
 * The state is stored as query parameters in the browser url
 * To read and manipulate the browser url
 *
 */
class StateManager {
  static #historyChange = false;

  //List of Callback methods that will be invoked if the history has been changed.
  static #historyCallbackListener = [];

  //List of Callback methods that will be invoked if the state has been changed.
  static #stateChangeCallbackListener = [];

  static {
    StateManager.#initHistorySupport(function () {
      StateManager.#historyChange = true;
      if (StateManager.#historyCallbackListener) {
        //Invoke the callback functions of the controllers that want to be notified
        $.each(StateManager.#historyCallbackListener, function (index, func) {
          func();
        });
      }
      StateManager.#historyChange = false;
      StateManager.#stateChanged();
    });
    StateManager.#updateUrlButton();
  }

  /**
   * Adds a history callback function to the StateManager.
   * All interested listener can register here to get informed about history change events.
   */
  static addHistoryCallback(historyCallback) {
    StateManager.#historyCallbackListener.push(historyCallback);
  }

  /**
   * Adds a history callback function to the StateManager.
   * All interested listener can register here to get informed about history change events.
   */
  static addStateChangeCallback(stateChangeCallback) {
    StateManager.#stateChangeCallbackListener.push(stateChangeCallback);
  }

  /**
   * Adds new paths to the history
   *
   * @param path the path to add to the history
   */
  static #changeHistory(path) {
    window.history.pushState({path: path}, '', path);
  }

  /**
   * Returns the benefit keyword values.
   */
  static getBenefits() {
    let result = new Set();
    const benefits = StateManager.getParameter(SearchParam.BENEFITS);

    if (benefits) {
      result = new Set(benefits.split(" "));
    }
    return result;
  }

  /**
   * Return the first value for the context facet field.
   */
  static getContextFacet() {
    let result = null;
    const contexts = StateManager.#getFacetValues(Facet.CONTEXT);

    if (contexts.length > 0) {
      result = contexts[0];
    }
    return result;
  }

  /**
   * Return all facet values.
   */
  static getFacets() {
    const facets = UrlManager.getFacets();

    return facets ? facets : [];
  }

  /**
   * Return the values for a given facet field.
   *
   * @param name the name of the facet
   */
  static #getFacetValues(name) {
    return UrlManager.getFacetValues(name);
  }

  /**
   * Return all filter values.
   */
  static getFilters() {
    const filters = UrlManager.getFilters();

    return filters ? filters : [];
  }

  static getLocations() {
    let result = new Set();
    const locations = StateManager.getParameter(SearchParam.LOCATIONS);

    if (locations) {
      result = new Set(locations.split(" "));
    }
    return result;
  }

  static getParameter(name) {
    return UrlManager.getParameter(name);
  }

  static getParameters() {
    return UrlManager.getParameters().toString();
  }

  static getPersons() {
    let result = new Set();
    const persons = StateManager.getParameter(SearchParam.PERSONS);

    if (persons) {
      result = new Set(persons.split(" "));
    }
    return result;
  }

  /**
   * Return the first value for the provider id facet field.
   */
  static getProviderIdFacet() {
    let result = null;
    const providerIds = StateManager.#getFacetValues(Facet.PROVIDER_ID);

    if (providerIds.length > 0) {
      result = providerIds[0];
    }
    return result;
  }

  /**
   * Return the first value for the provider name facet field.
   */
  static getProviderNameFacet() {
    let result = null;
    const providerNames = StateManager.#getFacetValues(Facet.PROVIDER_FCT);

    if (providerNames.length > 0) {
      result = providerNames[0];
    }
    return result;
  }

  static getQuery() {
    const query = StateManager.getParameter(SearchParam.QUERY);

    return query ? query : '';
  }

  static getRegions() {
    let result = new Set();
    const regions = StateManager.getParameter(SearchParam.REGIONS);

    if (regions) {
      result = new Set(regions.split(" "));
    }
    return result;
  }

  static getTopics() {
    let result = new Set();
    const topics = StateManager.getParameter(SearchParam.TOPICS);

    if (topics) {
      result = new Set(topics.split(" "));
    }
    return result;
  }

  static getUrl() {
    return UrlManager.getUrl();
  }

  static hasFacetValue(name, value) {
    return UrlManager.hasFacetValue(name, value);
  }

  static hasFilterValue(name, value) {
    return UrlManager.hasFilterValue(name, value);
  }

  /**
   * Initialize the history support for the search page(s)
   *
   * @param historyManager callback triggered on history state changes
   */
  static #initHistorySupport(historyManager) {
    if (window.history && history.pushState) {
      $(window).off('popstate').on('popstate', function () {
        historyManager(location.pathname + location.search);
      });
    }
  }

  /**
   * Pushes a given URL to the history stack and sets its value in the URL manager.
   */
  static pushState(url) {
    StateManager.#stateChanged(url);
  }

  static removeBenefit(id, doCallback) {
    const ids = StateManager.getBenefits();

    ids.delete(id);
    StateManager.setBenefits(ids, doCallback);
  }

  static removeBenefits(doCallback) {
    StateManager.removeParameter(SearchParam.BENEFITS, doCallback);
  }

  static removeContextFacet(doCallback, doHistory) {
    StateManager.removeFacet(Facet.CONTEXT, doCallback, doHistory);
  }

  static removeFacet(name, doCallback, doHistory) {
    $.each(StateManager.getFacets(), function (key, value) {
      const facet = new URLSearchParams(value);

      for (let nameValuePair of facet) {
        const facetName = nameValuePair[0];

        if (name && name.equals(facetName)) {
          StateManager.removeFacetValue(facetName, nameValuePair[1], doCallback, doHistory);
        }
      }
    });
  }

  static removeFacetValue(name, value, doCallback, doHistory) {
    let result = false;

    if (StateManager.hasFacetValue(name, value)) {
      StateManager.#stateChanged(UrlManager.removeFacetValue(name, value), doCallback, doHistory);
      result = true;
    }
    return result;
  }

  static removeFacets(doCallback, doHistory) {
    StateManager.#stateChanged(UrlManager.removeFacets(), doCallback, doHistory);
  }

  static removeFilterValue(name, value, doCallback) {
    let result = false;

    if (StateManager.hasFilterValue(name, value)) {
      //APD-620 Object page: remove context facet on archive filter change
      StateManager.removeContextFacet(false);
      StateManager.removeProviderIdFacet(false);
      StateManager.removeProviderNameFacet(false);
      StateManager.#stateChanged(UrlManager.removeFilterValue(name, value), doCallback);
      result = true;
    }
    return result;
  }

  static removeLocation(id, doCallback) {
    const ids = StateManager.getLocations();

    ids.delete(id);
    StateManager.setLocations(ids, doCallback);
  }

  static removeLocations(doCallback) {
    StateManager.removeParameter(SearchParam.LOCATIONS, doCallback);
  }

  static removeParameter(name, doCallback) {
    const values = StateManager.getParameter(name);

    if (values || doCallback) {
      StateManager.#stateChanged(UrlManager.removeParameter(name, values), doCallback);
    }
  }

  static removePerson(id, doCallback) {
    const ids = StateManager.getPersons();

    ids.delete(id);
    StateManager.setPersons(ids, doCallback);
  }

  static removePersons(doCallback) {
    StateManager.removeParameter(SearchParam.PERSONS, doCallback);
  }

  static removeProviderIdFacet(doCallback, doHistory) {
    StateManager.removeFacet(Facet.PROVIDER_ID, doCallback, doHistory);
  }

  static removeProviderNameFacet(doCallback, doHistory) {
    StateManager.removeFacet(Facet.PROVIDER_FCT, doCallback, doHistory);
  }

  static removeRegion(id, doCallback) {
    const ids = StateManager.getRegions();

    ids.delete(id);
    StateManager.setRegions(ids, doCallback);
  }

  static removeRegions(doCallback) {
    StateManager.removeParameter(SearchParam.REGIONS, doCallback);
  }

  static removeTopic(id, doCallback) {
    const ids = StateManager.getTopics();

    ids.delete(id);
    StateManager.setTopics(ids, doCallback);
  }

  static removeTopics(doCallback) {
    StateManager.removeParameter(SearchParam.TOPICS, doCallback);
  }

  static #replaceFacetValue(name, oldValue, newValue, doCallback, doHistory) {
    StateManager.#stateChanged(UrlManager.replaceFacetValue(name, oldValue, newValue), doCallback, doHistory);
  }

  /**
   * Remove all filters and facets.
   */
  static resetFilters() {
    StateManager.removeBenefits(false);
    StateManager.removeLocations(false);
    StateManager.removePersons(false);
    StateManager.removeRegions(false);
    StateManager.removeTopics(false);
    StateManager.#stateChanged(UrlManager.resetFilters(), false);
  }

  static setBenefits(ids, doCallback) {
    StateManager.setParameter(SearchParam.BENEFITS, Array.from(ids).join(" "), doCallback);
  }

  static setContextFacet(value, doCallback, doHistory) {
    StateManager.removeFacet(Facet.PROVIDER_ID, false);

    // Retrieve existing context facet values
    const oldValue = StateManager.getContextFacet();

    if (oldValue) {
      StateManager.#replaceFacetValue(Facet.CONTEXT, oldValue, value, doCallback, doHistory);
    } else {
      StateManager.setFacetValue(Facet.CONTEXT, value, doCallback, doHistory);
    }
  }

  static setFacetValue(name, value, doCallback, doHistory) {
    let result = false;

    if (!StateManager.hasFacetValue(name, value)) {
      StateManager.#stateChanged(UrlManager.setFacetValue(name, value), doCallback, doHistory);
      result = true;
    }
    return result;
  }

  static setFilterValue(name, value, doCallback) {
    let result = false;

    if (!StateManager.hasFilterValue(name, value)) {
      //APD-620 Object page: remove context facet on archive filter change
      StateManager.removeContextFacet(false);
      StateManager.removeProviderIdFacet(false);
      StateManager.removeProviderNameFacet(false);
      StateManager.#stateChanged(UrlManager.setFilterValue(name, value), doCallback);
      result = true;
    }
    return result;
  }

  static setLocations(ids, doCallback) {
    StateManager.setParameter(SearchParam.LOCATIONS, Array.from(ids).join(" "), doCallback);
  }

  static setParameter(name, value, doCallback) {
    StateManager.setParameters([[name, value]], doCallback);
  }

  static setParameters(paramsArray, doCallback) {
    StateManager.#stateChanged(UrlManager.setParameters(paramsArray), doCallback);
  }

  static setPersons(ids, doCallback) {
    StateManager.setParameter(SearchParam.PERSONS, Array.from(ids).join(" "), doCallback);
  }

  static setProviderIdFacet(value, doCallback, doHistory) {
    StateManager.removeFacet(Facet.CONTEXT, false);

    // Retrieve existing provider_id facet values
    const oldValue = StateManager.getProviderIdFacet();

    if (oldValue) {
      StateManager.#replaceFacetValue(Facet.PROVIDER_ID, oldValue, value, doCallback, doHistory);
    } else {
      StateManager.setFacetValue(Facet.PROVIDER_ID, value, doCallback);
    }
  }

  static setRegions(ids, doCallback) {
    StateManager.setParameter(SearchParam.REGIONS, Array.from(ids).join(" "), doCallback);
  }

  static setTopics(ids, doCallback) {
    StateManager.setParameter(SearchParam.TOPICS, Array.from(ids).join(" "), doCallback);
  }

  /**
   * Informs all registered listeners that the state has been changed.
   */
  static #stateChanged(url, doCallback, doHistory) {
    if (doCallback === undefined) {
      doCallback = true;
    }

    if (doHistory === undefined) {
      doHistory = true;
    }

    if (url && doHistory) {
      StateManager.#changeHistory(url);
    }
    //Invoke the callback functions of the controllers. Do not do this if historyChange flag is set
    //We use this variable because in some pages we don't want to update the search result, only the url.
    if (!StateManager.#historyChange && doCallback) {
      $.each(StateManager.#stateChangeCallbackListener, function (index, func) {
        func();
      });
    }
    StateManager.#updateUrlButton();
  }

  /**
   * When a filter or a facet is not/selected,
   * update automatically the attribute href the links with class as "update-href-js-button"
   */
  static #updateUrlButton() {
    const parameters = StateManager.getParameters();

    $('.update-href-js-button').each(function () {
      let baseUrl;

      if (this.nodeName.toLowerCase() === "a") {
        baseUrl = $(this).attr("href").split('?')[0];
        $(this).attr("href", baseUrl + (parameters ? "?" + parameters : ""));
      } else if (this.nodeName.toLowerCase() === "button") {
        baseUrl = $(this).attr("data-path").split('?')[0];
        $(this).attr("data-path", baseUrl + (parameters ? "?" + parameters : ""));
      }
    });
  }

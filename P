jQuery(function ($) {
  var form = $("#registration-form");

  form.closest(".modal").find("a").addClass("apd-link green");

  form.submit(function () {
    if (form.valid()) {
      var formParams = {
        email: form.find('input[name="email"]').val(),
        username: form.find('input[name="username"]').val(),
        passwd: form.find('input[name="passwd"]').val(),
        conpasswd: form.find('input[name="conpasswd"]').val(),
        fname: form.find('input[name="fname"]').val(),
        lname: form.find('input[name="lname"]').val(),
        modal: true
      };

      $.post(form.attr('action'), formParams, function (data) {
        if (!data || data.status === 200) {
          $(".modalView").modal('hide');
          GlobalScripts.displayConfirmationDialogMessage(
            form.find("#confirmation-messages").children('li').eq(0).children('a').text(),
            form.find("#confirmation-messages").children('li').eq(1).children('a').text()
          );
        } else {
          var errorListHtml = "";

          $.each(data.errors, function (i, error) {
            var message = error.split(".");

            errorListHtml += "<p>" + messages[message[0]][message[1]]() + "</p>";
          });
          $('#registrationErrorMessageContainer').html(errorListHtml);
          $(".apd-modal .apd-button.primary").removeClass("disabled");
        }
      });
    }
    return false;
  });

  form.validate({
    rules: {
      username: {
        required: true,
        minlength: 2,
        uid: true
      },
      email: {
        required: true,
        email: true
      },
      passwd: {
        required: true,
        minlength: 8
      },
      conpasswd: {
        required: true,
        equalTo: "#passwd"
      },
      termOfUse: {
        required: true
      },
      errorClass: "help-inline"
    },
    messages: {
      username: {
        required: form.find("#error-messages").children('li').eq(0).children('a').text(),
        minlength: form.find("#error-messages").children('li').eq(1).children('a').text(),
        uid: form.find("#error-messages").children('li').eq(5).children('a').text()
      },
      email: {
        required: form.find("#error-messages").children('li').eq(0).children('a').text(),
        email: form.find("#error-messages").children('li').eq(3).children('a').text()
      },
      passwd: {
        required: form.find("#error-messages").children('li').eq(0).children('a').text(),
        minlength: form.find("#error-messages").children('li').eq(2).children('a').text()
      },
      conpasswd: {
        required: form.find("#error-messages").children('li').eq(0).children('a').text(),
        equalTo: form.find("#error-messages").children('li').eq(4).children('a').text()
      },
      termOfUse: {
        required: form.find("#error-messages").children('li').eq(0).children('a').text()
      }
    },
    errorPlacement: function (error) {
      error.removeClass("error");
      $('#registrationErrorMessageContainer').html(error);
    }
  });

  $('#termOfUse').on("click", function () {
    $(this).parent().toggleClass('checked', $(this).prop('checked'));
    if ($(this).prop('checked')) {
      $('#registration-form').find('button[type=submit]').prop('disabled', false).removeAttr("tabindex");
    } else {
      $('#registration-form').find('button[type=submit]').prop('disabled', true).attr("tabindex", -1);
    }
  });

  $.validator.addMethod("uid", function (uid) {
    return uid.indexOf(':') < 0;
  });
});

/**
 * Keep the keyword counts in the portal subtree in sync with the rest of the search results page.
 */
class PortalMenu {
  constructor(portalId, ignoreKeywordClicks = false) {
    this.portalId = portalId;
    this.ignoreKeywordClicks = ignoreKeywordClicks;
  }

  #addKeywordId(keywordIds, keywordType, keywordId) {
    if (!keywordIds[keywordType]) {
      keywordIds[keywordType] = new Set();
    }
    keywordIds[keywordType].add(keywordId);
  }

  /**
   * Add all selected keywords to the current search.
   *
   * @param clickedKeyword If this is not null then add this keyword to the search, too.
   */
  #addKeywords(clickedKeyword) {
    const self = this;
    const clickedKeywordId = clickedKeyword ? clickedKeyword.data("value") : null;
    const keywordIds = self.#getGroupedKeywordIds();

    // collect all selected keywords
    $.each($(".collapsible_sub_menu .keyword.selected:not(.disabled)"), function () {
      const keywordId = $(this).data("value").toString();
      const keywordType = $(this).data("type").toString();

      if (!keywordId.equals(clickedKeywordId)) {
        self.#addKeywordId(keywordIds, keywordType, keywordId);
      }
    });

    // add clicked keyword
    if (clickedKeyword) {
      if (clickedKeyword.hasClass("selected")) {
        self.#removeKeywords(clickedKeyword);
      } else {
        const keywordType = clickedKeyword.data("type").toString();

        self.#addKeywordId(keywordIds, keywordType, clickedKeywordId);
        self.#setKeywordsParameter(keywordIds);
      }
      clickedKeyword.removeClass("hovered");
      clickedKeyword.toggleClass("selected");
    } else {
      self.#setKeywordsParameter(keywordIds);
    }
  }

  /**
   * Check whether all given keywords are disabled.
   */
  #allKeywordsDisabled(keywords) {
    let result = false;

    if (keywords.length > 0) {
      result = true;
      keywords.each(function () {
        if (!$(this).hasClass("disabled")) {
          result = false;
        }
      });
    }
    return result;
  }

  /**
   * Check whether all given keywords are selected.
   */
  #allKeywordsSelected(keywords) {
    let disabled = 0;
    let selected = 0;

    if (keywords.length > 0) {
      keywords.each(function () {
        if ($(this).hasClass("disabled")) {
          disabled++;
        } else if ($(this).hasClass("selected")) {
          selected++;
        }
      });
    }
    return selected > 0 && disabled + selected >= keywords.length;
  }

  /**
   * Get all keyword ids from the current URL grouped by their type.
   */
  #getGroupedKeywordIds() {
    const result = [];

    result["benefit"] = StateManager.getBenefits();
    result["location"] = StateManager.getLocations();
    result["person"] = StateManager.getPersons();
    result["region"] = StateManager.getRegions();
    result["topic"] = StateManager.getTopics();
    return result;
  }

  /**
   * Get all keyword ids from the current URL collected into one list.
   */
  #getKeywordIds() {
    const result = StateManager.getRegions();
    const topics = StateManager.getTopics();
    const benefits = StateManager.getBenefits();
    const locations = StateManager.getLocations();
    const persons = StateManager.getPersons();

    topics.forEach(result.add, result);
    benefits.forEach(result.add, result);
    locations.forEach(result.add, result);
    persons.forEach(result.add, result);
    return result;
  }

  handleSelectAllClick(selectCallback, unselectCallback) {
    const self = this;

    $(".collapsible_sub_menu input[name='select_all']").change(function () {
      const menuItem = $(this).closest(".menu_item");
      const container = $("#id_" + menuItem.data("id"));
      const type = menuItem.data("type");

      if (this.checked) {
        if (type.equals("category")) {
          self.#selectKeywords(container.find(".keyword"), selectCallback);
        } else {
          self.#selectKeywords($(this).parent().siblings().find(".keyword"), selectCallback);
        }
      } else {
        if (type.equals("category")) {
          self.#selectKeywords(container.find(".keyword"), unselectCallback);
        } else {
          self.#selectKeywords($(this).parent().siblings().find(".keyword"), unselectCallback);
        }
      }
      self.refreshCheckboxes();
    });
  }

  init() {
    const self = this;

    StateManager.addStateChangeCallback(function () {
      const keywordTypes = ["benefit", "location", "person", "region", "topic"];

      $.each(keywordTypes, function (index, keywordType) {
        self.#refreshKeywords(keywordType);
      });
    });

    // open top-level of the filter menu: set state of "select_all" checkbox
    $('.collapsible_menu .header_trigger').on("click", function () {
      if ($(this).parent().hasClass('panel-active')) {
        $(this).siblings(".collapsible_sub_menu").children(".dropmenu_item").find(".menu_item input[name='select_all']").each(function () {
          const selectAll = new Checkbox($(this));

          selectAll.setChecked(self.#allKeywordsSelected($("#id_" + $(this).closest(".menu_item").data("id")).find(".keyword")));
          selectAll.setDisabled(self.#allKeywordsDisabled($("#id_" + $(this).closest(".menu_item").data("id")).find(".keyword")));
        });
      }
    });

    // on category selection
    $(".category_toggle").on("shown.bs.collapse", function () {
      $(this).prev(".dropmenu_item:not(.leaf)").children(".menu_item").addClass("active");

      // check whether all child keywords are selected
      $(this).find(".collapsible_sub_menu input[name='select_all']").each(function () {
        const selectAll = new Checkbox($(this));

        selectAll.setChecked(self.#allKeywordsSelected($(this).parent().siblings().find(".keyword")));
        selectAll.setDisabled(self.#allKeywordsDisabled($(this).parent().siblings().find(".keyword")));
      });
    });

    // on category unselection
    $(".category_toggle").on("hidden.bs.collapse", function () {
      $(this).prevAll(".dropmenu_item:not(.leaf)").children(".menu_item").removeClass("active");
    });

    // on keyword click
    if (!self.ignoreKeywordClicks) {
      $(".collapsible_sub_menu .keyword .keyword-box").on("click", function () {
        self.#addKeywords($(this).closest(".keyword"));
      });
    }

    // forbid closing keywords dropdown
    $(".collapsible_sub_menu .dropdown-menu").on("click", function (e) {
      e.stopPropagation();
    });

    // select all keywords
    if (!self.ignoreKeywordClicks) {
      $(".collapsible_sub_menu input[name='select_all']").change(function () {
        const menuItem = $(this).closest(".menu_item");
        const container = $("#id_" + menuItem.data("id"));
        const type = menuItem.data("type");

        if (this.checked) {
          if (type.equals("category")) {
            container.find(".keyword").addClass("selected");
          } else {
            $(this).parent().siblings().find(".keyword").addClass("selected");
          }
          self.#addKeywords(null);
        } else {
          if (type.equals("category")) {
            self.#removeKeywords(container.find(".keyword").removeClass("selected"));
          } else {
            self.#removeKeywords($(this).parent().siblings().find(".keyword").removeClass("selected"));
          }
        }
      });
    }
  }

  /**
   * Refresh the state of all "select_all" checkboxes.
   */
  refreshCheckboxes() {
    const self = this;

    $(".collapsible_sub_menu input[name='select_all']").each(function () {
      const menuItem = $(this).closest(".menu_item");
      const type = menuItem.data("type");
      const selectAll = new Checkbox($(this));

      if (type && type.equals("category")) {
        selectAll.setChecked(self.#allKeywordsSelected($("#id_" + $(this).closest(".menu_item").data("id")).find(".keyword")));
        selectAll.setDisabled(self.#allKeywordsDisabled($("#id_" + $(this).closest(".menu_item").data("id")).find(".keyword")));
      } else {
        selectAll.setChecked(self.#allKeywordsSelected($(this).parent().siblings().find(".keyword")));
        selectAll.setDisabled(self.#allKeywordsDisabled($(this).parent().siblings().find(".keyword")));
      }
    });
  }

  /**
   * Refresh the count and selected state of every keyword in the portal subtree.
   *
   * @param type keyword type (topic or region)
   */
  #refreshKeywords(type) {
    const self = this;
    const keywordIds = self.#getKeywordIds();
    const parameters = new URLSearchParams(StateManager.getParameters());

    parameters.set(SearchParam.PORTAL_ID, self.portalId);
    parameters.set("type", type);

    $.getJSON(jsContextPath + "/themenportale/weimarer-republik/keywordcounts?" + parameters.toString(), function (data) {
      $(".keyword[data-type=" + type + "]").each(function (index, keyword) {
        const keywordId = $(keyword).data("value").toString();

        // refresh count
        const keywordCount = data[keywordId] ? data[keywordId] : 0;

        $(keyword).find(".keyword-count").text(keywordCount);
        if (keywordCount > 0) {
          $(keyword).removeClass("disabled");
        } else {
          $(keyword).addClass("disabled");
        }

        // refresh selected state
        if (keywordIds.has(keywordId)) {
          $(keyword).addClass("selected");
        } else {
          $(keyword).removeClass("selected");
        }
      });
      self.refreshCheckboxes();
    });
  }

  /**
   * Remove the given keywords from the current search.
   */
  #removeKeywords(keywords) {
    const keywordIds = {};

    keywordIds["benefit"] = StateManager.getBenefits();
    keywordIds["location"] = StateManager.getLocations();
    keywordIds["person"] = StateManager.getPersons();
    keywordIds["region"] = StateManager.getRegions();
    keywordIds["topic"] = StateManager.getTopics();

    keywords.each(function () {
      const keywordId = $(this).data("value").toString();

      $.each(keywordIds, function (type) {
        keywordIds[type].delete(keywordId);
      });
    });

    this.#setKeywordsParameter(keywordIds);
  }

  /**
   * Starts the given callback to (un)select all keywords in the given list of keywords.
   */
  #selectKeywords(keywords, callback) {
    keywords.each(function () {
      const keywordId = $(this).data("value");
      const keywordType = $(this).data("type");

      callback(keywordId, keywordType);
    });
  }

  /**
   * Set the keyword search parameter from the given keyword id list.
   */
  #setKeywordsParameter(keywordIds) {
    const removeFunctions = [];
    const setFunctions = [];

    removeFunctions["benefit"] = function () {
      StateManager.removeBenefits(false);
    };
    removeFunctions["location"] = function () {
      StateManager.removeLocations(false);
    };
    removeFunctions["person"] = function () {
      StateManager.removePersons(false);
    };
    removeFunctions["region"] = function () {
      StateManager.removeRegions(false);
    };
    removeFunctions["topic"] = function () {
      StateManager.removeTopics(false);
    };
    setFunctions["benefit"] = function (ids) {
      StateManager.setBenefits(ids, false);
    };
    setFunctions["location"] = function (ids) {
      StateManager.setLocations(ids, false);
    };
    setFunctions["person"] = function (ids) {
      StateManager.setPersons(ids, false);
    };
    setFunctions["region"] = function (ids) {
      StateManager.setRegions(ids, false);
    };
    setFunctions["topic"] = function (ids) {
      StateManager.setTopics(ids, false);
    };

    $(["benefit", "location", "person", "region", "topic"]).each((index, element) => {
      const ids = keywordIds[element];

      if (ids && ids.size) {
        setFunctions[element](ids);
      } else {
        removeFunctions[element]();
      }
    });

    // trigger the URL update only once
    StateManager.pushState(window.location.href);
  }
}

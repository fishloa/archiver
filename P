class FreeTextSearch {
  static #HIDDEN = "hidden";
  static #INPUT_FIELD = ".search-slot .query";

  keywordLabels = null;
  searchInput = null;
  searchValue = "";

  constructor(container) {
    this.container = container;
  }

  attachSearchListener() {
    const self = this;

    self.keywordLabels = $(self.container).find(".keyword-box .keyword-label");
    self.searchInput = $(FreeTextSearch.#INPUT_FIELD);
    $(self.searchInput).on("keyup", function () {
      self.searchValue = $(this).val().toLowerCase();
      self.#showHideKeywords();
      if (self.searchValue.length > 1) {
        self.#filterKeywords();
      }
    });
    self.clearSelection();
  }

  #cleanValue(value) {
    return value.replace(/[0-9()]/g, '').toLowerCase().trim();
  }

  clearSelection() {
    if (this.searchInput) {
      this.searchInput.val("");
    }
    this.searchValue = "";
    this.#showHideKeywords();
  }

  #filterKeywords() {
    const self = this;

    self.keywordLabels.each(function () {
      let text = $(this).text();
      let trimmedText = self.#cleanValue(text);
      let wordChecked = trimmedText.indexOf(self.searchValue);

      if (wordChecked >= 0) {
        $(this).parent().parent().removeClass(FreeTextSearch.#HIDDEN);
      }
    });
  }

  #showHideKeywords() {
    const hide = this.searchValue.length > 1;

    $(this.container).find(".keyword").each(function () {
      if (hide) {
        $(this).addClass(FreeTextSearch.#HIDDEN);
      } else {
        $(this).removeClass(FreeTextSearch.#HIDDEN);
      }
    });
  }
}

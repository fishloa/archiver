de.ddb.common.search.initHistorySupport = function (stateManager) {
  if (window.history && history.pushState) {
    historyedited = false;
    historySupport = true;
    $(window).on('popstate', function () {
      if ((forceStateManagerCallback || historyedited) && stateManager) {

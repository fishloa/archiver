jQuery(function ($) {
  const form = $("#password-reset-form");

  form.validate({
    rules: {
      usernameOrEmail: {
        required: true
      },
      errorClass: "help-inline"
    },

    messages: {
      usernameOrEmail: {
        required: form.find("#error-messages").children('li').eq(0).children('a').text()
      }
    },

    errorPlacement: function (error, element) {
      error.insertBefore(element);
    }
  });

  form.on("submit", function (e) {
    e.preventDefault();
    if (form.valid()) {
      var usernameOrEmail = form.find('input[name="usernameOrEmail"]').val();
      var formParams = {
        username: usernameOrEmail
      };

      $.post(form.attr('action'), formParams, function (data) {
        var response = $.parseHTML(data);
        var errors = $(response).find('.errors-container').first().find('li');
        var messages = $(response).find('.messages-container').first().find('li');
        var message = null;

        if (errors.length > 0) {
          message = errors.text();
        } else if (messages.length > 0) {
          message = messages.text();
        }
        if (message) {
          form.parent().append("<p class='serverResponseMessage'>" + message + "</p>");
          form.closest(".modal").find(".modal-footer").css("display", "flex");
          form.hide();
        }
      });
    }
    return false;
  });

  $("#resetPasswordModal").on("hidden.bs.modal", function () {
    $(this).find(".modal-footer").hide();
    form.show();
    $(this).find(".serverResponseMessage").remove();
  });
});

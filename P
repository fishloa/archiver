jQuery(function ($) {
  const SLIDER = ".object-gallery .auto-width";

  /**
   * Builds the lightSlider for the carousel
   * @returns {{lightSlider}|*|jQuery|HTMLElement}
   */
  function buildSlider() {
    const slider = $(SLIDER);

    if (slider.length) {
      slider.lightSlider({
        enableDrag: false,
        autoWidth: true,
        slideMargin: 20,
        loop: false,
        controls: false,
        onAfterSlide: function (slider) {
          disableButtons(slider);
        },
        onSliderLoad: function () {
          $(SLIDER).removeClass('cS-hidden');
        }
      });
    }
    return slider;
  }

  /**
   * Builds a map structure following the structure:
   * key: filter value
   * value : array[] slide elements <li>
   * @returns {{slideStructure}}
   */
  function buildSlideStructure() {
    let slideStructure = {};
    let slideList = $('.lslide').toArray();

    slideList.forEach(function (slide) {
      let filterValue = $(slide).data("value");

      if (!slideStructure[filterValue]) {
        slideStructure[filterValue] = [];
      }
      slideStructure[filterValue].push(slide);
    });
    return slideStructure;
  }

  function disableButtons(slider) {
    if (slider.length) {
      const currentSlide = slider.getCurrentSlideCount();
      const totalSlides = slider.getTotalSlideCount();

      $('#goToPrevSlide').attr("disabled", currentSlide === 1);
      $('#goToNextSlide').attr("disabled", currentSlide >= totalSlides - 1);
    }
  }

  let slider = buildSlider();
  let slideStructure = buildSlideStructure();

  $('#goToPrevSlide').click(function () {
    slider.goToPrevSlide();
  });

  $('#goToNextSlide').click(function () {
    slider.goToNextSlide();
  });

  // Add active class to the current control button (highlight it)
  $("#object-filter-buttons").find(".filter-carousel-button").each(function () {
    this.addEventListener("click", function () {
      $(".filter-carousel-button").removeClass("active");
      $(this).addClass("active");

      slider.children().remove();
      slider.append(slideStructure[$(this).attr("value")]);
      slider.append(slideStructure["no-filter-slide"]);
      slider.goToSlide(0);
      slider.refresh();
    });
  });

  disableButtons(slider);
});

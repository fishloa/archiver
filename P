de.ddb.common.cookie.decodeCookieValue = function (value) {
  return Base64.decode(value);
};

/**
 * Return a specific cookie if this exists
 * @name Name of the cookie to read
 */
de.ddb.common.cookie.readCookie = function (name) {
  var nameEQ = name + "=";
  var ca = document.cookie.split(';');
  for (var i = 0; i < ca.length; i++) {
    var c = ca[i];
    while (c.charAt(0) === ' ') {
      c = c.substring(1, c.length);
    }
    if (c.indexOf(nameEQ) === 0) {
      return c.substring(nameEQ.length, c.length);
    }
  }
  return null;
};

de.ddb.common.cookie.encodeCookieName = function (name) {
  return encodeURIComponent(name);
};

de.ddb.common.cookie.encodeCookieValue = function (value) {
  return Base64.encode(value);
};

de.ddb.common.cookie.encodeCookieTime = function (value) {
  return encodeURIComponent(value);
};

/**
 * Create a JSON object from the cookie content.
 */
de.ddb.common.cookie.parseCookie = function (cookieName) {
  var result = {};
  var parameters = de.ddb.common.cookie.readCookie(de.ddb.common.cookie.encodeCookieName(cookieName));

  if (parameters) {
    result = JSON.parse(de.ddb.common.cookie.decodeCookieValue(parameters));
  }
  return result;
};

/**
 * Remove a specific value into the parameter cookie of the current context path.
 * @paramName name of the parameter to remove
 * @value value of the parameter to remove
 */
de.ddb.common.cookie.removeCookieParameterValue = function (paramName, value, cookieName) {
  var json = de.ddb.common.cookie.parseCookie(cookieName);

  $.each(json, function (key, jsonValue) {
    if (key === paramName) {
      if (jsonValue.constructor === Array) {
        $.each(jsonValue, function (arrayKey, arrayValue) {
          if (value === arrayValue) {
            var index = jsonValue.indexOf(arrayValue);
            jsonValue.splice(index, 1);
          }
        });
      } else {
        if (value === jsonValue) {
          delete json[paramName];
        }
      }
    }
  });

  de.ddb.common.cookie.setCookie(cookieName, JSON.stringify(json));
};

/**
 * Create a json cookie of parameters to the current context path
 * @param arrayParamVal array of parameters values
 */
de.ddb.common.cookie.setCookieParameter = function (arrayParamVal, cookieName) {
  var json = de.ddb.common.cookie.parseCookie(cookieName);

  $.each(arrayParamVal, function (key, value) {
    json[value[0]] = value[1];
  });

  de.ddb.common.cookie.setCookie(cookieName, JSON.stringify(json));
};

/**
 * Remove a whole parameter of the parameter cookie of the current context path
 * @paramName name of the parameter to remove
 */
de.ddb.common.cookie.removeCookieParameter = function (paramName, cookieName) {
  var json = de.ddb.common.cookie.parseCookie(cookieName);

  //deletes the attribute from the JSON
  delete json[paramName];
  de.ddb.common.cookie.setCookie(cookieName, JSON.stringify(json));
};

de.ddb.common.cookie.setCookie = function (name, value) {
  let cookieString = de.ddb.common.cookie.encodeCookieName(name) + "=" +
    de.ddb.common.cookie.encodeCookieValue(value) + ";path=/";

  // Add "Secure" only if protocol is HTTPS
  if (location.protocol === "https:") {
    cookieString += "; Secure";
  }

  document.cookie = cookieString;
};
